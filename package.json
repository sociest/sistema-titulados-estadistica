{
  "name": "sistema-seguimiento-estadistica",
  "version": "1.5.0",
  "packageManager": "pnpm@10.15.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:docker": "sh -c 'export DATABASE_URL=$(node scripts/db-url.mjs 2>/dev/null); next dev'",
    "db:migrate:docker": "sh -c 'export DATABASE_URL=$(node scripts/db-url.mjs 2>/dev/null); drizzle-kit migrate'",
    "seed:docker": "sh -c 'export DATABASE_URL=$(node scripts/db-url.mjs 2>/dev/null); tsx scripts/seed.ts'",
    "seed:masivo:docker": "sh -c 'export DATABASE_URL=$(node scripts/db-url.mjs 2>/dev/null); tsx scripts/seed_masivo.ts'",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "seed:masivo": "tsx scripts/seed_masivo.ts",
    "generar:datos": "python3 scripts_generar_seed.py --salida datos_prueba.csv --registros 290 --titulados 135",
    "test": "tsx --test tests/*.test.ts",
    "backup": "bash scripts/backup.sh"
  },
  "dependencies": {
    "@types/pdfkit": "^0.17.6",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "lucide-react": "^0.408.0",
    "next": "14.2.5",
    "pdfkit": "^0.20.2",
    "pg": "^8.12.0",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.12.7",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.11.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "drizzle-kit": "^0.24.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.5",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.16.2",
    "typescript": "^5"
  }
}
