# ═══════════════════════════════════════════════════════════════════════════════
#  PLANTILLA DE VARIABLES — AQUÍ NO VA NINGÚN DATO REAL
#
#  Este archivo SÍ se sube al repositorio, por eso solo trae nombres y valores vacíos.
#  Los valores reales van en `.env`, que NUNCA se sube (.gitignore y .dockerignore).
#
#      cp .env.example .env            (Windows:  copy .env.example .env)
#
#  Después edite `.env` y complete cada línea marcada como OBLIGATORIA.
#  Docker Compose, `pnpm dev`, los scripts y drizzle-kit leen ese mismo `.env`.
#  En producción (Dokploy) NO se usa archivo: cargue las mismas variables en la
#  pestaña "Environment" del servicio.
# ═══════════════════════════════════════════════════════════════════════════════


# ── Base de datos (Docker) ─────────────────────────────────────────────────────
DB_USER=seguit_app
DB_NAME=sistitulados_db
# OBLIGATORIA. Genere una:  openssl rand -hex 24
DB_PASSWORD=
# Puerto de PostgreSQL publicado en su equipo (5433 evita chocar con un PostgreSQL nativo).
DB_PORT=5433

# Solo si corre la app con `pnpm dev` contra un PostgreSQL que NO es el de Docker:
# DATABASE_URL=postgresql://USUARIO:CLAVE@127.0.0.1:5432/NOMBRE_BD


# ── Aplicación ─────────────────────────────────────────────────────────────────
# Puerto en que Docker publica la app y URL pública que usan los enlaces de los correos.
# Con `pnpm dev` (sin Docker) cambie ambas URLs a http://localhost:3000.
# En producción: https://su-dominio.umsa.bo
APP_HOST_PORT=3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
SITIO_URL=http://localhost:3001
TZ=America/La_Paz

# OBLIGATORIA. Firma las sesiones. Distinta en local y en producción.
#   openssl rand -hex 32      (o:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=


# ── Correo SMTP (verificación de registro y recuperación de contraseña) ────────
# Sin estas variables el sistema NO envía nada: escribe el enlace en el log.
# Verifique la configuración con:   pnpm correo:probar su-correo@gmail.com
#
# Opción recomendada — Gmail de uso exclusivo del sistema (gratis, ~500 correos/día):
#   1. Cree una cuenta Gmail NUEVA solo para el sistema (no use una personal).
#   2. Active la verificación en 2 pasos y genere una "Contraseña de aplicación".
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587
#   SMTP_USER = esa cuenta Gmail completa
#   SMTP_PASS = la contraseña de aplicación de 16 letras, SIN espacios
#   CORREO_REMITENTE = Sistema SEGUIT <esa-misma-cuenta@gmail.com>
# Alternativa con dominio propio — Brevo (gratis, 300/día): verifique su dominio en Brevo
#   SMTP_HOST=smtp-relay.brevo.com   SMTP_PORT=587
#   SMTP_USER = el "Login" de Brevo → SMTP & API   SMTP_PASS = clave SMTP generada ahí
SMTP_HOST=
SMTP_PORT=587
# "true" solo para el puerto 465 (TLS implícito). Con 587 déjelo vacío o en false.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Formato:  Sistema SEGUIT <correo-verificado@dominio>
CORREO_REMITENTE=


# ── Cloudflare Turnstile (captcha) ─────────────────────────────────────────────
# Vacías = modo de prueba local (siempre válido). EN PRODUCCIÓN SON OBLIGATORIAS:
# créelas gratis en dash.cloudflare.com → Turnstile y agregue su dominio.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# ── Usuario Kardex inicial (seed) ──────────────────────────────────────────────
# Solo se usan si se ejecuta el seed. Sin contraseña, el seed NO crea la cuenta.
KARDEX_SEED_EMAIL=
KARDEX_SEED_PASSWORD=


# ── Despliegue ─────────────────────────────────────────────────────────────────
AUTORUN_MIGRATIONS=true
# Solo true en una base de pruebas: el seed crea cuentas de demostración.
AUTORUN_SEED=false
PG_VOLUME_NAME=sistitulados_postgres_data
